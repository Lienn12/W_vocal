# Sao chép thành .env rồi sửa. KHÔNG đưa file .env lên mạng/Git.
# Tên miền trỏ về IP máy chủ. Chưa có tên miền thì dùng dạng 203-0-113-10.sslip.io (thay bằng IP của bạn, dấu chấm thành gạch ngang).
DOMAIN=bibo.example.com
# Đặt mật khẩu dài, ngẫu nhiên (ví dụ: openssl rand -hex 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Mã để vào trang "Tạo nội dung" (bắt buộc khi chạy trên mạng)
EDITOR_KEY=
# Khi chạy máy cá nhân bằng docker-compose.yml: cổng mở web
WEB_PORT=8080
